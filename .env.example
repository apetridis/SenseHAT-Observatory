# Example only. Replace the bind address with an IPv4 address assigned to the
# Raspberry Pi, or let scripts/install.sh create the private .env automatically.
LAN_BIND_IP=192.168.1.100
GRAFANA_PORT=3000
INFLUX_PORT=8086
DOCKER_INFLUXDB_INIT_USERNAME=observatory
DOCKER_INFLUXDB_INIT_PASSWORD=replace-with-a-long-random-password
DOCKER_INFLUXDB_INIT_ORG=sensehat-observatory
DOCKER_INFLUXDB_INIT_BUCKET=environment
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=replace-with-a-long-random-token

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace-with-a-different-long-random-password

# The collector runs on the Pi host and connects through its configured address.
INFLUX_URL=http://192.168.1.100:8086
INFLUX_ORG=sensehat-observatory
INFLUX_BUCKET=environment
INFLUX_TOKEN=replace-with-a-long-random-token
